# Copy this file to .env and fill in the values you need.
# Only uncomment the variables you plan to use.

# NVD data source: mirror (default) or api.
# Use api to enable CPE downloads (requires NVD_API_KEY).
# NVD_SOURCE=api

# NVD 2.0 API key issued by NVD. Required for CPE data or when NVD_SOURCE=api.
# NVD_API_KEY=your-api-key-here

# Optional comma-separated years of CVE data to fetch (e.g. 2023,2024) or "all".
# When unset, only Recent/Modified feeds are pulled.
# NVD_YEARS=2023,2024
