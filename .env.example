# Copy this file to .env and fill in the values you need.
# Only uncomment the variables you plan to use.

# NVD data source: mirror (default) or api.
# Use api to enable CPE downloads (requires NVD_API_KEY).
# NVD_SOURCE=api

# NVD 2.0 API key issued by NVD. Required for CPE data or when NVD_SOURCE=api.
# NVD_API_KEY=your-api-key-here

# Optional comma-separated years of CVE data to fetch (e.g. 2023,2024) or "all".
# When unset, only Recent/Modified feeds are pulled.
# NVD_YEARS=2023,2024

# Override the default endpoints if you host your own mirror/API (faster, fewer limits):
# - NVD_MIRROR_BASE: base URL serving CVE .json.xz feeds (e.g. your mirror of fkie-cad).
# - NVD_API_BASE: base URL for the NVD 2.0 API; set NVD_SOURCE=api to use this for CVE/CPE.
#   If your custom API also serves CPE, set both NVD_SOURCE=api and NVD_API_BASE; NVD_API_KEY if required by your server.
# NVD_MIRROR_BASE=https://your-mirror.example.com/releases/latest/download
# NVD_API_BASE=https://your-api.example.com
# NVD_API_CVE_PATH=/nvd/v1/cve   # override if your API path differs from /cves/2.0
# NVD_API_CPE_PATH=/nvd/v1/cpe   # override if your API path differs from /cpes/2.0
# If your API requires a query (e.g., keywordSearch) even for bulk fetches:
# NVD_CVE_QUERY_KEYWORD=*        # default "*" satisfies servers that require keywordSearch
# NVD_CPE_QUERY_KEYWORD=*        # default "*" for CPE keywordSearch if required
# Allow CPE download without API key (if your server permits):
# NVD_ALLOW_CPE_NO_KEY=true

# Adjust rate throttling when using custom servers:
# - NVD_RATE_LIMIT: max requests allowed per window (default 50 with key / 5 without).
# - NVD_RATE_WINDOW: window size in seconds (default 30).
# - NVD_RATE_DISABLED: set to true to disable throttling (use only if your server allows it).
# NVD_RATE_LIMIT=100
# NVD_RATE_WINDOW=10
# NVD_RATE_DISABLED=false

# Page sizes (defaults: CVE 2000, CPE 10000). Raise/lower to match your server limits.
# NVD_CVE_PAGE_SIZE=2000
# NVD_CPE_PAGE_SIZE=10000
